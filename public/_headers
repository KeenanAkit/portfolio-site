# Cloudflare Pages cache strategy.
# Photos and built assets are content-hashed (Astro generates immutable URLs
# like /_astro/four-o-nine-toronto.<hash>.avif), so they can cache forever.
# HTML routes must revalidate on every visit so content updates land instantly.
# See KPort design doc § operational hardening for the rationale.

# Immutable: Astro-built CSS/JS/images, fingerprinted in their filenames.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static assets from public/ that don't change often. Sitemap + RSS update
# on every deploy so revalidation matters; OG default rarely changes.
/og-default.png
  Cache-Control: public, max-age=86400, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate

# RSS feed and sitemap: re-fetch frequently.
/rss.xml
  Cache-Control: public, max-age=300, must-revalidate
/sitemap-*.xml
  Cache-Control: public, max-age=300, must-revalidate

# HTML pages: always revalidate so the user sees fresh content after deploys.
# Cloudflare's edge cache still serves the stale copy while it revalidates,
# so this is fast even with a low max-age.
/
  Cache-Control: public, max-age=0, must-revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate

# Security headers: stricter defaults to ship from day one.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
