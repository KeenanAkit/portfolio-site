{
  "name": "kport",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Keenan Akit's personal portfolio. Windows 98 on desktop, photo-first on mobile.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:slop": "node scripts/check-slop.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:a11y:full": "npm run build && node scripts/check-a11y.mjs",
    "post:new": "node scripts/new-post.mjs",
    "sync:photos": "node scripts/sync-folder.mjs",
    "sync:sprites": "node scripts/ingest-sprite.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prebuild": "npm run check:slop && npm run check && npm run test"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/react": "^5.0.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "98.css": "^0.1.21",
    "astro": "^6.3.8",
    "gsap": "^3.15.0",
    "marked": "^18.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/cli": "^4.11.3",
    "@vitest/coverage-v8": "^4.1.8",
    "exifr": "^7.1.3",
    "happy-dom": "^20.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.101.0"
  }
}
