---
// Sticky header on every mobile page. Wordmark + tagline + contact link.
// Visible only when data-ui="mobile".

interface Props {
  tagline?: string;
}

const { tagline = 'Photos & projects' } = Astro.props;
---

<header class="mobile-header" data-only="mobile">
  <a href="/" class="wordmark" data-astro-prefetch>Keenan Akit</a>
  <span class="tagline">{tagline}</span>
</header>

<style>
  .mobile-header {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-5);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: saturate(180%) blur(8px);
  }

  .wordmark {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .wordmark:hover {
    color: var(--color-text-primary);
  }

  .tagline {
    font-size: var(--text-meta);
    color: var(--color-text-secondary);
    font-family: var(--font-body);
  }
</style>
