---
// Stacked blog post list. Used on the mobile homepage (latest N) and on
// /blog (full list).

import { getCollection } from 'astro:content';

interface Props {
  limit?: number;
  showHeading?: boolean;
}

const { limit, showHeading = true } = Astro.props;

const all = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const posts = typeof limit === 'number' ? all.slice(0, limit) : all;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<section class="post-list" data-only="mobile" aria-labelledby="posts-heading">
  {showHeading && (
    <header class="section-header">
      <h2 id="posts-heading">Latest posts</h2>
      {limit && <a href="/blog" class="all-link" data-astro-prefetch>All posts →</a>}
    </header>
  )}

  {
    posts.length === 0 ? (
      <p class="empty">First post is on its way.</p>
    ) : (
      <ul>
        {posts.map((p) => (
          <li class="post-row">
            <h3>
              <a href={`/blog/${p.id}`} data-astro-prefetch>{p.data.title}</a>
            </h3>
            <p class="meta">
              <time class="tnum" datetime={p.data.date.toISOString()}>
                {fmtDate(p.data.date)}
              </time>
              {p.data.tags.length > 0 && (
                <span class="tags">
                  {p.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </span>
              )}
            </p>
            <p class="excerpt">{p.data.excerpt}</p>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .post-list {
    padding: var(--space-5) var(--space-5) var(--space-6);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .all-link {
    font-size: var(--text-meta);
    color: var(--color-link);
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-row {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-strong);
  }
  .post-row:last-child {
    border-bottom: none;
  }

  .post-row h3 {
    margin: 0 0 var(--space-2);
  }
  .post-row h3 a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .meta {
    margin: 0 0 var(--space-2);
    font-size: var(--text-meta);
    color: var(--color-text-tertiary);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .tag {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    padding: 0 var(--space-2);
    margin-right: var(--space-1);
    font-size: var(--text-caption);
    color: var(--color-text-secondary);
  }

  .excerpt {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  .empty {
    color: var(--color-text-secondary);
    font-size: var(--text-meta);
  }
</style>
