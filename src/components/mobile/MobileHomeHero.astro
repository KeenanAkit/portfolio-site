---
// Mobile homepage hero. Renders the first featured photo OR a graceful
// placeholder if none exists yet. Once /photo-add lands real photos with
// featured: true, this auto-fills.

import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const featured = (await getCollection('photos', (p) => p.data.featured)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const hero = featured[0];
---

{
  hero ? (
    <section class="mobile-hero" data-only="mobile" aria-label="Featured photo">
      <a href={`/photos/gallery/${hero.id}`} data-astro-prefetch>
        <Image
          src={hero.data.image}
          alt={hero.data.caption ?? hero.data.title}
          inferSize
          widths={[480, 720, 960, 1280]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          format="avif"
          quality={75}
          class="hero-image"
        />
      </a>
    </section>
  ) : (
    <section
      class="mobile-hero placeholder"
      data-only="mobile"
      aria-label="Hero placeholder"
    >
      <div class="placeholder-inner">
        <p>Hero photo lands here. Add one via <code>/photo-add</code>.</p>
      </div>
    </section>
  )
}

<style>
  .mobile-hero {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  .mobile-hero a {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(
        45deg,
        var(--color-bg-elevated),
        var(--color-bg-elevated) 12px,
        var(--color-border) 12px,
        var(--color-border) 13px
      );
  }

  .placeholder-inner {
    background: var(--color-bg);
    border: 1px solid var(--color-border-strong);
    padding: var(--space-4) var(--space-5);
    text-align: center;
  }

  .placeholder p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-meta);
  }

  .placeholder code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    background: var(--color-bg-elevated);
    padding: 2px 6px;
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }
</style>
