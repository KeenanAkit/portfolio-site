---
// Stacked project cards on the mobile homepage. One per row.
// Featured projects only on homepage; full list at /projects.

import { getCollection } from 'astro:content';

const projects = (
  await getCollection('projects', (p) => p.data.featured)
).sort((a, b) => b.data.year - a.data.year);
---

<section class="project-cards" data-only="mobile" aria-labelledby="projects-heading">
  <header class="section-header">
    <h2 id="projects-heading">Side projects</h2>
    <a href="/projects" class="all-link" data-astro-prefetch>All projects →</a>
  </header>

  {
    projects.length === 0 ? (
      <p class="empty">No featured projects yet.</p>
    ) : (
      <ul class="project-list">
        {projects.map((p) => (
          <li class="project-card">
            <div class="meta">
              <h3>
                <a href={`/projects/${p.id}`} data-astro-prefetch>{p.data.title}</a>
              </h3>
              <p class="summary">{p.data.summary}</p>
              <span class="year tnum">{p.data.year}</span>
            </div>
            <a href={`/projects/${p.id}`} class="btn-win98" data-astro-prefetch>
              Open
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .project-cards {
    padding: var(--space-5) var(--space-5) var(--space-6);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .all-link {
    font-size: var(--text-meta);
    color: var(--color-link);
    text-decoration: none;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .project-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .meta {
    flex: 1;
    min-width: 0;
  }

  .meta h3 {
    margin: 0 0 var(--space-1);
  }
  .meta h3 a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .summary {
    margin: 0 0 var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-meta);
    line-height: 1.45;
  }

  .year {
    font-size: var(--text-caption);
    color: var(--color-text-tertiary);
  }

  .empty {
    color: var(--color-text-secondary);
    font-size: var(--text-meta);
  }
</style>
