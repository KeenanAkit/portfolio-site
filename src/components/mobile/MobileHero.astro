---
// Edge-to-edge hero photo on the mobile homepage.
// Aspect ratio 16:10, full-bleed.

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
}

const { image, alt } = Astro.props;
---

<section class="mobile-hero" data-only="mobile" aria-label="Featured photo">
  <Image
    src={image}
    alt={alt}
    widths={[480, 720, 960, 1280]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    format="avif"
    quality={75}
    class="hero-image"
  />
</section>

<style>
  .mobile-hero {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  .hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
